# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Either name works: NEXT_PUBLIC_SUPABASE_ANON_KEY or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SERVER ONLY - never expose. Used by checkout and webhook to write orders.
# Either name works: SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Paystack (Dashboard > Settings > API Keys). SERVER ONLY.
PAYSTACK_SECRET_KEY=sk_test_xxx

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brand contact
NEXT_PUBLIC_WHATSAPP_NUMBER=2348069848955
